{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@fleece/api-common": ["../../src/ts/api-common/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["**/__tests__/**", "node_modules"]
}
